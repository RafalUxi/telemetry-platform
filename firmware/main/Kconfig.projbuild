menu "Telemetry device"

config WIFI_SSID
    string "WiFi SSID"
    default "myssid"
    help
        Name of the network this device joins.

config WIFI_PASSWORD
    string "WIFI PASSWORD"
    default ""
    help
        Leave empty for an open network.

config WIFI_MAX_RETRY
    int "Maximum connection attempts before giving up"
    default 5

config MQTT_BROKER_URI
    string "Broker URI"
    default "mqtt://192.168.1.18:1883"
    help
        Address of the MQTT broker on the development machine.

config DEVICE_ID
    string "Device id registered through the API"
    default ""

config DEVICE_PASSWORD
    string "Device password shown once at registration"
    default ""

endmenu