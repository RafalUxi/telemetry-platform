# cp .env.example .env
# docker compose reads .env automatically from the project root.

POSTGRES_USER=telemetry
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=telemetry

# Host-side URLs: app processes run on the host in step 1.
# In step 3, when the API moves into a container, the host becomes the
# compose service name (postgres / redis / mosquitto), not localhost.
DATABASE_URL=postgres://telemetry:local-dev-only@localhost:5432/telemetry
REDIS_URL=redis://localhost:6379
MQTT_URL=mqtt://localhost:1883
JWT_SECRET=
MQTT_ADMIN_USERNAME=
MQTT_ADMIN_PASSWORD=
MQTT_INGEST_USERNAME=
MQTT_INGEST_PASSWORD=
MQTT_SIM_USERNAME=
MQTT_SIM_PASSWORD=
